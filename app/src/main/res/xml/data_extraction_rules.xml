<?xml version="1.0" encoding="utf-8"?>
<!-- OS backup and device transfer stay off because feed URLs may contain personal tokens. The user makes a full backup explicitly (Settings > Storage and data), to a file of their choice. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
